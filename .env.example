# Mock mode is the safe default and must always work without provider credentials.
MAIL_PROVIDER=mock

# Add provider credentials only in a local .env.local after the matching
# integration challenge lands. Never commit real values.
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_TENANT_ID=
# GMAIL_CLIENT_ID=
# GMAIL_CLIENT_SECRET=

# The database scaffold will use a local, ignored file during development.
DATABASE_URL=file:../data/signal.db
